[Unit]
Description=MythOS privileged operation service
Documentation=man:mythosctl(1)
After=dbus.service

[Service]
Type=dbus
BusName=org.mythos.Privileged
ExecStart=/usr/bin/mythos-privileged-service
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
