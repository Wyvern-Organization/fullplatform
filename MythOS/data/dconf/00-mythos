[org/gnome/desktop/interface]
color-scheme='prefer-dark'
accent-color='blue'
enable-animations=true
show-battery-percentage=true
clock-show-date=true
clock-show-seconds=false
clock-show-weekday=false
font-name='Manrope 11'
document-font-name='Manrope 11'
monospace-font-name='Adwaita Mono 11'
# Keep the physical-monitor choice in GNOME's hands. A zero scaling factor is
# the automatic setting; fractional scales remain available in Displays.
scaling-factor=uint32 0
text-scaling-factor=1.0

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/mythos/velvet-rays.png'
picture-uri-dark='file:///usr/share/backgrounds/mythos/velvet-rays.png'
picture-options='zoom'
primary-color='#090b12'
secondary-color='#172238'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/mythos/velvet-rays.png'
picture-options='zoom'
lock-enabled=true
lock-delay=uint32 0

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
focus-mode='click'
resize-with-right-button=true

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
two-finger-scrolling-enabled=true

[org/gnome/mutter]
auto-maximize=true
dynamic-workspaces=true
edge-tiling=true
experimental-features=['scale-monitor-framebuffer', 'variable-refresh-rate', 'xwayland-native-scaling']

[org/gnome/shell]
disable-user-extensions=false
welcome-dialog-last-shown-version='999.0'
enabled-extensions=['dash-to-panel@jderose9.github.com', 'arcmenu@arcmenu.com', 'ubuntu-appindicators@ubuntu.com', 'blur-my-shell@aunetx', 'mythos-shell@mythos.local']
favorite-apps=['org.gnome.Nautilus.desktop', 'firefox-esr.desktop', 'org.gnome.Software.desktop', 'org.mythos.SystemHub.desktop']

[org/gnome/shell/extensions/dash-to-panel]
extension-version=9999
panel-positions='{"0":"BOTTOM"}'
panel-sizes='{"0":52}'
panel-lengths='{"0":90}'
panel-anchors='{"0":"MIDDLE"}'
panel-element-positions='{"0":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":false,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}]}'
show-activities-button=false
show-running-apps=true
show-favorites=true
show-favorites-all-monitors=false
group-apps=true
isolate-workspaces=false
isolate-monitors=false
click-action='CYCLE-MIN'
dot-style-focused='SOLID'
dot-style-unfocused='DOTS'
dot-position='BOTTOM'
dot-size=3
dot-color-override=true
dot-color-1='#4c6fff'
dot-color-2='#4c6fff'
dot-color-3='#4c6fff'
dot-color-4='#4c6fff'
focus-highlight=true
focus-highlight-color='#c8d7ff'
focus-highlight-opacity=18
panel-top-bottom-margins=8
panel-side-margins=18
panel-top-bottom-padding=2
panel-side-padding=8
trans-use-custom-opacity=true
trans-use-dynamic-opacity=false
trans-panel-opacity=0.82
intellihide=false
stockgs-keep-dash=false
stockgs-keep-top-panel=false
stockgs-panelbtn-click-only=true
show-window-previews=true
show-tooltip=true
animate-app-switch=true
animate-window-launch=true
animate-appicon-hover=true
animate-appicon-hover-animation-type='SIMPLE'
appicon-padding=6
appicon-margin=3

[org/gnome/shell/extensions/arcmenu]
menu-layout='Eleven'
position-in-panel='Left'
menu-button-appearance='Icon'
menu-button-icon='Custom_Icon'
custom-menu-button-icon='/usr/share/icons/hicolor/scalable/apps/org.mythos.SystemHub.svg'
custom-menu-button-icon-size=22.0
button-padding=8
hotkey-open-primary-monitor=true
show-search-result-details=true
search-entry-border-radius=(true, 16)
update-notifier-enabled=false

[org/gnome/shell/extensions/appindicator]
icon-size=18
tray-pos='right'

[org/gnome/settings-daemon/plugins/power]
power-button-action='interactive'
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='suspend'
sleep-inactive-battery-timeout=1200
ambient-enabled=true

[org/gnome/desktop/privacy]
remember-recent-files=true
recent-files-max-age=30
remove-old-temp-files=true
remove-old-trash-files=true
old-files-age=uint32 30
disable-camera=false
disable-microphone=false

[org/gnome/software]
download-updates=true
download-updates-notify=true
allow-updates=true

[org/gnome/desktop/notifications/application/org-gnome-software]
application-id='org.gnome.Software.desktop'
enable=false
