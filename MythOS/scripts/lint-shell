#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
# Portable file collection (avoid mapfile which requires bash 4+; macOS ships bash 3.2)
FILES=()
while IFS= read -r file; do
    FILES+=("$file")
done < <(
    find \
        "${PROJECT_ROOT}/scripts" \
        "${PROJECT_ROOT}/config/hooks" \
        "${PROJECT_ROOT}/data/grub" \
        "${PROJECT_ROOT}/data/initramfs" \
        -type f -print 2>/dev/null | sort
)

for file in "${FILES[@]}"; do
    first_line="$(head -n 1 "${file}")"
    if [[ "${first_line}" == *bash* ]]; then
        bash -n "${file}"
    elif [[ "${first_line}" == '#!/bin/sh' ]]; then
        sh -n "${file}"
    fi
done

if command -v shellcheck >/dev/null 2>&1; then
    shellcheck "${FILES[@]}"
fi
