{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osaii",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.png"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "osaii",
      "database_id": "f83a97b5-6301-45fe-8821-6393934f6aac"
    }
  ],
  "r2_buckets": [
    { "binding": "STUDIO_FILES", "bucket_name": "osaii-studio" }
  ],
  "browser": { "binding": "BROWSER" },
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "MASQUE_SEARCH", "index_name": "osaii-masque-search" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MASQUE_SESSIONS", "class_name": "MasqueSession" },
      { "name": "COSAII_RELAYS", "class_name": "CosaiiRelay" }
    ]
  },
  "migrations": [
    { "tag": "masque-v1", "new_sqlite_classes": ["MasqueSession"] },
    { "tag": "cosaii-v1", "new_sqlite_classes": ["CosaiiRelay"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "routes": [
    {
      "pattern": "osaii.wyvernhub.net",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "minify": true,
  "vars": {
    "CODEX_ADAPTER_URL": "https://osaii-codex-adapter.netlify.app"
  }
  // Secrets (via `wrangler secret put` / .dev.vars locally):
  //   INVITE_SECRET, POOLSIDE_API_KEY (canonical, 2 O's) / POOOLSIDE_API_KEY (legacy 3-O alias),
  //   LOGFARE_API_KEY, GROQ_API_KEY, POLLINATIONS_API_KEY, CLOUDFLARE_API_TOKEN, MASQUE_ADMIN_EMAILS
  // Poolside alias normalized in API/poolside.ts:getPoolsideApiKey() + src/index.ts:poolsideKey()
}
