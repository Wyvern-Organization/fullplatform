# OSAII Platform — environment template for tooling / deploy helpers
# Copy to .env if your local tooling expects it, but Worker dev uses .dev.vars.
# .env and .dev.vars are git-ignored — never commit real secrets.
# Keep in sync with .dev.vars.example.

# Invite gate for auditor signup
INVITE_SECRET=

# Poolside inference (canonical POOLSIDE_API_KEY, legacy POOOLSIDE_API_KEY alias)
POOLSIDE_API_KEY=
POOOLSIDE_API_KEY=

# Logfare Advanced models
LOGFARE_API_KEY=

# Safety providers
GROQ_API_KEY=
POLLINATIONS_API_KEY=

# Cloudflare
CLOUDFLARE_API_TOKEN=

# Masque admin bootstrap (comma-separated)
MASQUE_ADMIN_EMAILS=

# Optional: D1 / R2 identifiers if you use a personal preview stack
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
